              <div className="flex gap-3">
                <button
                  onClick={() => setCurrentStage(2)}
                  className="w-1/3 py-3 rounded-xl font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs"
                >
                  Rudi Nyuma
                </button>
                <button
                  disabled={selectedSeats.length === 0}
                  onClick={() => setCurrentStage(4)}
                  className="w-2/3 bg-amber-500 hover:bg-amber-600 text-emerald-950 font-black py-3 rounded-xl shadow text-xs disabled:opacity-50"
                >
                  {t.proceedPayment}
                </button>
              </div>
            </div>
          </div>
        )}

        {/* STAGE 4: LATRA MANIFEST FORM */}
        {currentStage === 4 && (
          <div className="max-w-xl mx-auto bg-white rounded-2xl p-6 md:p-8 border border-slate-200 shadow-sm space-y-6">
            <div className="border-b pb-3">
              <span className="text-xs text-amber-600 font-bold uppercase tracking-wider">{t.step4}</span>
              <h2 className="text-xl font-extrabold text-slate-900">{t.latraManifest}</h2>
              <p className="text-xs text-slate-500 mt-1">Taarifa hizi zinahitajika kisheria na LATRA kwa ajili ya daftari la abiria.</p>
            </div>

            <form onSubmit={handlePassengerSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">{t.fullName}</label>
                <input
                  type="text"
                  required
                  value={passengerDetails.fullName}
                  onChange={(e) => setPassengerDetails({ ...passengerDetails, fullName: e.target.value })}
                  placeholder="mf. Juma Hamisi Rashid"
                  className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">{t.phone}</label>
                <input
                  type="tel"
                  required
                  value={passengerDetails.phone}
                  onChange={(e) => setPassengerDetails({ ...passengerDetails, phone: e.target.value })}
                  placeholder="07XXXXXXXX"
                  className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-bold uppercase text-slate-700 mb-1">{t.gender}</label>
                  <select
                    value={passengerDetails.gender}
                    onChange={(e) => setPassengerDetails({ ...passengerDetails, gender: e.target.value })}
                    className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500"
                  >
                    <option value="Mwanaume">{t.male}</option>
                    <option value="Mwanamke">{t.female}</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold uppercase text-slate-700 mb-1">{t.nida}</label>
                  <input
                    type="text"
                    value={passengerDetails.nida}
                    onChange={(e) => setPassengerDetails({ ...passengerDetails, nida: e.target.value })}
                    placeholder="NIDA Number (Sio Lazima)"
                    className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold outline-none focus:ring-2 focus:ring-emerald-500"
                  />
                </div>
              </div>

              <div className="pt-4 flex gap-3">
                <button
                  type="button"
                  onClick={() => setCurrentStage(3)}
                  className="w-1/3 py-3 rounded-xl font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs"
                >
                  Rudi Nyuma
                </button>
                <button
                  type="submit"
                  className="w-2/3 bg-amber-500 hover:bg-amber-600 text-emerald-950 font-black py-3 rounded-xl shadow text-xs"
                >
                  Endelea Kwenye Kuonyeshwa Namba ya Malipo
                </button>
              </div>
            </form>
          </div>
        )}

        {/* STAGE 5: MANUAL PAYMENT TO LIPA NAMBA 352225438 (SafariBora / EMILSON) */}
        {currentStage === 5 && (
          <div className="max-w-xl mx-auto bg-white rounded-2xl p-6 md:p-8 border border-slate-200 shadow-sm space-y-6">
            <div className="text-center border-b pb-4">
              <span className="text-xs text-amber-600 font-bold uppercase tracking-wider">{t.step5}</span>
              <h2 className="text-xl font-extrabold text-slate-900">{t.selectPayment}</h2>
              <p className="text-xs text-slate-500 mt-1">{t.manualPayInstruction}</p>
            </div>

            <div className="bg-emerald-900 text-white rounded-2xl p-5 shadow-md flex justify-between items-center">
              <div>
                <p className="text-xs text-emerald-200 font-medium">Jumla ya Nauli Unayopaswa Kutuma</p>
                <p className="text-3xl font-black text-amber-400">{calculateTotal().toLocaleString()} TZS</p>
              </div>
              <span className="text-xs font-bold bg-emerald-800 text-emerald-100 px-3 py-1.5 rounded-lg border border-emerald-700">
                Viti {selectedSeats.length} ({selectedSeats.join(', ')})
              </span>
            </div>

            {/* MERCHANT DISPLAY & RECIPIENT NAME PROMPT */}
            <div className="bg-amber-50 border-2 border-amber-300 rounded-2xl p-5 space-y-3">
              <div className="flex items-center justify-between border-b border-amber-200 pb-2">
                <span className="text-xs text-amber-900 font-extrabold uppercase">Lipa Namba ya Biashara</span>
                <span className="text-[10px] bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-bold">Merchant Payment</span>
              </div>
              
              <div className="flex items-center justify-between">
                <div>
                  <span className="text-xs text-slate-500 block">Lipa Namba (M-Pesa / Tigo / Airtel):</span>
                  <span className="text-2xl font-black text-slate-900 tracking-wider">{t.targetPhone}</span>
                </div>
                <div className="text-right">
                  <span className="text-xs text-slate-500 block">Jina la Biashara:</span>
                  <span className="text-xs font-black text-emerald-900 bg-emerald-100 px-2 py-1 rounded border border-emerald-300 inline-block">
                    {t.targetName}
                  </span>
                </div>
              </div>

              {/* RECIPIENT VERIFICATION WARNING */}
              <div className="bg-amber-100/90 border border-amber-300 p-3 rounded-xl flex items-start gap-2.5 text-xs text-amber-950 font-medium">
                <AlertCircle className="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
                <p>{t.nameVerifyPrompt}</p>
              </div>

              {/* CLICKABLE USSD DIALER BUTTONS */}
              <div className="pt-2 border-t border-amber-200/60 space-y-2">
                <span className="text-[11px] font-bold text-slate-600 block text-center uppercase tracking-wider">
                  {lang === 'SW' ? 'Bofya hapa chini kufungua menyu ya kulipa:' : 'Click below to launch mobile money menu:'}
                </span>
                <div className="grid grid-cols-3 gap-2">
                  <a
                    href="tel:*150*00%23"
                    className="bg-white hover:bg-red-50 border-2 border-red-200 hover:border-red-400 p-2 rounded-xl text-center transition shadow-sm flex flex-col items-center justify-center group"
                  >
                    <span className="block text-red-600 font-black text-xs group-hover:scale-105 transition-transform">M-Pesa</span>
                    <span className="text-[10px] text-slate-500 font-mono font-bold">*150*00#</span>
                  </a>

                  <a
                    href="tel:*150*01%23"
                    className="bg-white hover:bg-blue-50 border-2 border-blue-200 hover:border-blue-400 p-2 rounded-xl text-center transition shadow-sm flex flex-col items-center justify-center group"
                  >
                    <span className="block text-blue-600 font-black text-xs group-hover:scale-105 transition-transform">Tigo Pesa</span>
                    <span className="text-[10px] text-slate-500 font-mono font-bold">*150*01#</span>
                  </a>

                  <a
                    href="tel:*150*60%23"
                    className="bg-white hover:bg-rose-50 border-2 border-rose-200 hover:border-rose-400 p-2 rounded-xl text-center transition shadow-sm flex flex-col items-center justify-center group"
                  >
                    <span className="block text-rose-600 font-black text-xs group-hover:scale-105 transition-transform">Airtel Money</span>
                    <span className="text-[10px] text-slate-500 font-mono font-bold">*150*60#</span>
                  </a>
                </div>
              </div>
            </div>

            <form onSubmit={handleSimulatePayment} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1">
                  {t.senderPhoneLabel}
                </label>
                <input
                  type="tel"
                  required
                  value={paymentPhone || passengerDetails.phone}
                  onChange={(e) => setPaymentPhone(e.target.value)}
                  className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-semibold focus:ring-2 focus:ring-emerald-500 outline-none"
                  placeholder="07XXXXXXXX"
                />
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-700 mb-1 flex justify-between">
                  <span>{t.txnRefLabel}</span>
                  <span className="text-amber-600 font-bold">*Lazima</span>
                </label>
                <input
                  type="text"
                  required
                  value={transactionRef}
                  onChange={(e) => setTransactionRef(e.target.value.toUpperCase())}
                  className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-sm font-bold tracking-widest uppercase focus:ring-2 focus:ring-emerald-500 outline-none"
                  placeholder={t.txnRefPlaceholder}
                />
                <p className="text-[11px] text-slate-400 mt-1">
                  Weka namba ya kumbukumbu (Transaction ID) uliyotumiwa kwa SMS baada ya kulipia kwenda Lipa Namba 352225438 (SafariBora / EMILSON).
                </p>
              </div>

              <div className="pt-2 flex gap-3">
                <button
                  type="button"
                  onClick={() => setCurrentStage(4)}
                  className="w-1/3 py-3 rounded-xl font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs"
                >
                  Rudi Nyuma
                </button>
                <button
                  type="submit"
                  disabled={isProcessingPayment}
                  className="w-2/3 bg-amber-500 hover:bg-amber-600 text-emerald-950 font-black py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-sm"
                >
                  {isProcessingPayment ? (
                    <>
                      <RefreshCw className="w-4 h-4 animate-spin" />
                      <span>Inahakiki Muamala...</span>
                    </>
                  ) : (
                    <>
                      <CheckCircle2 className="w-4 h-4" />
                      <span>{t.verifyPaymentBtn}</span>
                    </>
                  )}
                </button>
              </div>
            </form>
          </div>
        )}

        {/* STAGE 6: E-TICKET VIEW */}
        {currentStage === 6 && (
          <div className="max-w-2xl mx-auto space-y-6">
            <div className="bg-emerald-800 text-white p-6 rounded-2xl shadow-lg text-center space-y-2">
              <div className="w-12 h-12 bg-amber-400 text-emerald-950 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">
                ✓
              </div>
              <h2 className="text-2xl font-black">{t.ticketConfirmed}</h2>
              <p className="text-emerald-200 text-xs">Ujumbe wa SMS umetumwa kwa namba {passengerDetails.phone || paymentPhone}</p>
            </div>

            <div className="bg-white rounded-3xl border-2 border-slate-200 shadow-xl overflow-hidden relative">
              <div className="bg-emerald-950 text-white p-5 flex justify-between items-center border-b border-emerald-800">
                <div>
                  <span className="text-amber-400 text-xs font-bold uppercase tracking-wider block">PNR / Kumbukumbu</span>
                  <span className="text-2xl font-black tracking-widest">{pnrCode || 'SB-849201'}</span>
                </div>
                <div className="text-right">
                  <span className="bg-emerald-800 text-emerald-200 text-[10px] uppercase font-bold px-2.5 py-1 rounded-md block mb-1">
                    LATRA Verified
                  </span>
                  <span className="text-[10px] text-amber-300 font-mono font-bold block">
                    Txn: {transactionRef || '8HG92KL81Z'}
                  </span>
                </div>
              </div>

              <div className="p-6 space-y-6">
                <div className="grid grid-cols-2 gap-4 border-b pb-4">
                  <div>
                    <span className="text-xs text-slate-400 uppercase font-semibold block">Basi & Kampuni</span>
                    <span className="font-extrabold text-slate-800 text-base">{selectedBus?.name || 'Kilimanjaro Express'}</span>
                    <span className="text-xs text-emerald-700 block">{selectedBus?.busType}</span>
                  </div>
                  <div>
                    <span className="text-xs text-slate-400 uppercase font-semibold block">Tarehe ya Safari</span>
                    <span className="font-extrabold text-slate-800 text-base">{travelDate}</span>
                    <span className="text-xs text-slate-500 block">Saa: {selectedBus?.departureTime}</span>
                  </div>
                </div>

                <div className="bg-slate-50 p-4 rounded-xl flex items-center justify-between border border-slate-100">
                  <div>
                    <span className="text-[10px] text-slate-400 font-bold uppercase block">Kutoka</span>
                    <span className="font-bold text-slate-800 text-sm">{fromCity}</span>
                  </div>
                  <ArrowRight className="w-5 h-5 text-amber-500" />
                  <div className="text-right">
                    <span className="text-[10px] text-slate-400 font-bold uppercase block">Kwenda</span>
                    <span className="font-bold text-slate-800 text-sm">{toCity}</span>
                  </div>
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs border-b pb-4">
                  <div>
                    <span className="text-slate-400 font-semibold block">Jina la Abiria</span>
                    <span className="font-bold text-slate-800">{passengerDetails.fullName || 'Juma Rashid'}</span>
                  </div>
                  <div>
                    <span className="text-slate-400 font-semibold block">Viti Vyako</span>
                    <span className="font-black text-amber-600 text-sm">{selectedSeats.join(', ') || '14, 15'}</span>
                  </div>
                  <div>
                    <span className="text-slate-400 font-semibold block">Jumla ya Nauli</span>
                    <span className="font-bold text-emerald-900">{calculateTotal().toLocaleString()} TZS</span>
                  </div>
                  <div>
                    <span className="text-slate-400 font-semibold block">Kumbukumbu ya Malipo</span>
                    <span className="font-mono font-bold text-slate-700">{transactionRef || '8HG92KL81Z'}</span>
                  </div>
                </div>

                <div className="flex items-center justify-between pt-2">
                  <div className="space-y-1">
                    <p className="text-[11px] font-bold text-slate-700">Tafadhali onyesha tiketi hii au namba ya PNR wakati wa kupanda basi.</p>
                    <p className="text-[10px] text-slate-400">Malipo yamethibitishwa kupitia Lipa Namba 352225438 (SafariBora / EMILSON)</p>
                  </div>
                  <div className="w-16 h-16 bg-slate-900 rounded-lg p-1 flex items-center justify-center text-white text-[8px] font-mono tracking-tighter text-center">
                    [QR CODE VALID]
                  </div>
                </div>
              </div>

              <div className="bg-slate-50 p-4 border-t border-slate-200 flex gap-3">
                <button 
                  onClick={() => window.print()}
                  className="w-1/2 bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2"
                >
                  <Download className="w-4 h-4" /> {t.printTicket}
                </button>
                <button 
                  onClick={() => setCurrentStage(1)}
                  className="w-1/2 bg-amber-500 hover:bg-amber-600 text-emerald-950 font-bold py-3 rounded-xl text-xs flex items-center justify-center gap-2"
                >
                  <span>Katakoni Tiketi Nyingine</span>
                </button>
              </div>
            </div>
          </div>
        )}

      </main>

      {/* TRACKING MODAL */}
      {showLookupModal && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div className="flex justify-between items-center border-b pb-3">
              <h3 className="font-bold text-slate-900">{t.trackTicket}</h3>
              <button onClick={() => setShowLookupModal(false)} className="text-slate-400 hover:text-slate-600">✕</button>
            </div>
            
            <p className="text-xs text-slate-500">Weka namba yako ya PNR kupata tiketi yako tena.</p>

            <input
              type="text"
              placeholder="mf. SB-849201"
              value={lookupPnr}
              onChange={(e) => setLookupPnr(e.target.value)}
              className="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-sm font-bold uppercase focus:ring-2 focus:ring-emerald-500 outline-none"
            />

            <button
              onClick={() => {
                if(lookupPnr) {
                  setPnrCode(lookupPnr);
                  setShowLookupModal(false);
                  setCurrentStage(6);
                }
              }}
              className="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 rounded-xl text-sm"
            >
              Tafuta Tiketi
            </button>
          </div>
        </div>
      )}

      {/* FOOTER */}
      <footer className="bg-slate-900 text-slate-400 text-xs py-6 border-t border-slate-800 mt-12">
        <div className="max-w-5xl mx-auto px-4 text-center space-y-2">
          <p className="text-slate-300 font-semibold">SafariBora Tanzania • LATRA E-Ticketing Compliant Platform</p>
          <p className="text-slate-500">Integrated with M-Pesa, Tigo Pesa, Airtel Money for Intercity Bus Travel</p>
        </div>
      </footer>

    </div>
  );
}