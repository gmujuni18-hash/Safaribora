    e.preventDefault();
    if (!passengerDetails.fullName || !passengerDetails.phone) {
      alert(lang === 'SW' ? 'Tafadhali jaza Jina na Namba ya Simu!' : 'Please complete Name and Phone Number!');
      return;
    }
    setCurrentStage(5);
  };

  const handleSimulatePayment = (e) => {
    e.preventDefault();
    if (!transactionRef || transactionRef.trim().length < 5) {
      alert(lang === 'SW' ? 'Tafadhali weka namba halali ya muamala (Transaction ID)!' : 'Please enter a valid Transaction Reference ID!');
      return;
    }
    setIsProcessingPayment(true);
    const generatedPNR = 'SB-' + Math.floor(100000 + Math.random() * 900000);
    
    setTimeout(() => {
      setIsProcessingPayment(false);
      setPnrCode(generatedPNR);
      setCurrentStage(6);
    }, 1200);
  };

